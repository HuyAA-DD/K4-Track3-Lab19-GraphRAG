# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=openai/gpt-oss-120b

# --- Coreference LLM (OpenAI) ---
COREF_PROVIDER=openai
COREF_MODEL=gpt-4o-mini
COREF_BATCH_SIZE=12
COREF_MAX_WORKERS=5
EXTRACTION_PROVIDER=openai
EXTRACTION_MODEL=gpt-4o-mini
EXTRACTION_BATCH_SIZE=10
EXTRACTION_MAX_WORKERS=5
GENERATION_PROVIDER=openai
GENERATION_MODEL=gpt-4o-mini

# --- LLM-as-a-Judge (OpenAI hoặc Groq) ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
